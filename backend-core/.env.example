# Copy to .env / .env.docker and fill values. Never commit real secrets.

APP_NAME=Volera
APP_ENV=Development
APP_URL=http://localhost:22820

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL — use your existing server/container (compose does NOT start Postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=appdb
POSTGRES_USER=root
POSTGRES_PASSWORD=changeme_use_strong_password
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=appdb;Username=root;Password=changeme_use_strong_password

# Local Docker published ports (random by default in docker-compose.yml):
#   API      http://localhost:18327
#   Frontend https://localhost:18262  (accept self-signed cert — required for calls)

# Redis (optional; presence/cache)
REDIS_URL=
ConnectionStrings__Redis=redis:6379,abortConnect=false

# Seq (existing container on Docker network — Serilog sink; no Mongo error logs)
# From webapi container → Seq: use http://seq (Seq listens on :80 inside the network).
# From host browser / local `dotnet run`: http://localhost:5341
SEQ_URL=http://seq
SEQ_UI_URL=http://localhost:5341
Seq__ServerUrl=http://seq
Seq__UiUrl=http://localhost:5341

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=changeme_access_key
MINIO_SECRET_KEY=changeme_secret_key
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
Storage__EndpointUrl=http://minio:9000
# RequestHost signs against the browser Host (LAN mobile). Fallback used by background jobs.
Storage__PublicEndpointMode=RequestHost
Storage__PublicEndpointUrl=https://192.168.1.4:18262
Storage__AccessKey=changeme_access_key
Storage__SecretKey=changeme_secret_key
Storage__BucketName=volera-media
Storage__UseSsl=false
Storage__Region=us-east-1

# JWT (required; min 32 chars; unique per environment)
JWT_SECRET=changeme_generate_a_unique_secret_at_least_32_chars
Jwt__Key=changeme_generate_a_unique_secret_at_least_32_chars
Jwt__Issuer=Volera
Jwt__Audience=Volera
Jwt__SupportUser__Key=changeme_generate_another_unique_secret_32plus
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=7d
ENCRYPTION_KEY=

# Company auth — NEVER enable in production
Auth__AllowDemoCompanyOtp=false

# Realtime / WebRTC (self-hosted Coturn in docker-compose — works across different networks)
# Coturn is STUN + TURN. TURN is required when users are not on the same LAN.
#
# Required for production / multi-network calls:
#   TURN_PUBLIC_HOST = IP or DNS that browsers can reach (server public IP, e.g. 185.164.72.106)
#   TURN_EXTERNAL_IP = same as TURN_PUBLIC_HOST in most setups (advertised in ICE candidates)
# Open firewall: UDP+TCP TURN_PORT (default 3478), UDP 40000-40050
# On Windows Docker Desktop, Hyper-V often blocks 3478 — use TURN_PORT=5349 locally.
#
# Leave TURN_PUBLIC_HOST empty only for local same-machine testing (ICE falls back to request Host).
COTURN_ENABLED=true
TURN_PUBLIC_HOST=
TURN_EXTERNAL_IP=
TURN_PORT=3478
TURN_REALM=volera
TURN_USERNAME=volera
TURN_CREDENTIAL=changeme_turn_credential_use_strong_secret
# Optional overrides (comma-separated). Empty = auto-build from TURN_PUBLIC_HOST / request Host.
STUN_SERVER_URL=
TURN_SERVER_URL=
REALTIME_URL=

# SMTP (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Web Push (VAPID)
PUSH_PROVIDER=vapid
PUSH_CREDENTIALS=
VapidPublicKey=
VapidPrivateKey=

# Seed (optional local admin)
SeedAdmin__Username=
SeedAdmin__Password=

# Demo content for testing (users, contacts, groups, DMs, calls, stories, system messages)
# Default true when unset. Set to false on production if you do not want demo rows.
SeedDemo__Enabled=true

# Frontend (compose)
VITE_API_URL=
NEXT_PUBLIC_API_URL=
