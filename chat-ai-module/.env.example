# =============================================================================
# Ollama-only configuration (no OpenAI API key required)
# =============================================================================

# LLM: use Ollama for chat (widget and agent)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Embeddings: use Ollama for RAG (widget ingest and query)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=znbang/bge:large-en-v1.5-f16

# Agent
MAX_AGENT_STEPS=10

# Logging
LOG_LEVEL=INFO

# Postgres (same DB as .NET backend). Widget RAG reads AiContentBlocks from this DB.
# Use a local/dev connection string — never commit real credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/VoiceCallApp

# -----------------------------------------------------------------------------
# Optional: switch to OpenAI (set LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
